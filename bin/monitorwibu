#!/usr/bin/env python3
"""MONITOR WIBU v2 — CLI master.

Perintah:
    monitorwibu add-node <NAMA>     buat kunci node + cetak perintah pemasangan node
    monitorwibu del-node <NAMA>     hapus node (kunci langsung tak berlaku)
    monitorwibu list                daftar node + umur laporan terakhir
    monitorwibu render              susun & kirim/perbarui pesan dashboard Telegram
    monitorwibu show                cetak pesan dashboard ke layar (tanpa kirim)
    monitorwibu test                uji cepat: kirim laporan palsu bertanda tangan sendiri
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/monitorwibu")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import monitorwibu  # noqa: E402

CONF_PATH = os.environ.get("MONITORWIBU_CONF", "/etc/monitorwibu/master.conf")


def load_conf(path: str) -> dict:
    conf: dict[str, str] = {}
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip().strip('"')
    return conf


CONF = load_conf(CONF_PATH)
STATE = CONF.get("STATE_DIR", "/var/lib/monitorwibu")
NODES_DB = CONF.get("NODES_DB", "/etc/monitorwibu/nodes.json")
REPORTS = os.path.join(STATE, "nodes")
MSG_ID_FILE = os.path.join(STATE, "message_id")
FRESH = int(CONF.get("FRESH", str(monitorwibu.FRESH)))
TZ = CONF.get("TZ", "WIB")


def die(msg: str) -> None:
    print(f"  [!] {msg}", file=sys.stderr)
    raise SystemExit(1)


def tg(method: str, **fields) -> dict:
    token = CONF.get("BOT_TOKEN")
    if not token:
        die("BOT_TOKEN belum diisi di master.conf")
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(f"https://api.telegram.org/bot{token}/{method}", data=data)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as exc:
        # C-2: badan JSON Telegram (mis. description "message to edit not found")
        # harus dipertahankan supaya cmd_render bisa membuang id pesan basi.
        try:
            return json.loads(exc.read().decode())
        except Exception:
            return {"ok": False, "description": str(exc)}
    except Exception as exc:  # jaringan/telegram
        return {"ok": False, "description": str(exc)}


# ------------------------------------------------------------------- perintah
def cmd_add_node(name: str) -> int:
    db = monitorwibu.NodeDB(NODES_DB)
    try:
        key = db.add(name)
    except monitorwibu.Invalid as exc:
        die(str(exc))
    host = CONF.get("PUBLIC_HOST") or CONF.get("MASTER_IP", "<IP-MASTER>")
    port = CONF.get("PORT", "5000")
    scheme = "https" if CONF.get("TLS_CERT") else "http"
    insecure = " --insecure" if scheme == "https" and CONF.get("TLS_SELF_SIGNED", "0") == "1" else ""
    print(f"  ✅ Node '{name}' didaftarkan (kunci 64 hex, mode 600: {NODES_DB})")
    print("\n  Jalankan di VPS node:")
    print(f"    bash install-node.sh --master {scheme}://{host}:{port} --name {name} --key {key}{insecure}")
    print("\n  Kunci tidak bisa ditampilkan lagi sesudah ini — simpan baik-baik.")
    return 0


def cmd_del_node(name: str) -> int:
    try:
        name = monitorwibu.sanitize_name(name)   # B-8: tolak nama traversal
    except monitorwibu.Invalid as exc:
        die(str(exc))
    db = monitorwibu.NodeDB(NODES_DB)
    ok = db.remove(name)
    for path in (os.path.join(REPORTS, f"{name}.json"),):
        if os.path.exists(path):
            os.unlink(path)
    print(f"  {'✅ dihapus' if ok else '[!] tidak ada'}: {name}")
    return 0 if ok else 1


def cmd_list() -> int:
    db = monitorwibu.NodeDB(NODES_DB)
    reports = {n: (d, a) for n, d, a in monitorwibu.read_reports(REPORTS, fresh=10 ** 9)}
    if not db.nodes:
        print("  (belum ada node — tambah: monitorwibu add-node <NAMA>)")
        return 0
    print(f"  {'NODE':<18} {'LAPORAN':<12} {'UPTIME':<18} LAYANAN")
    for name in sorted(db.nodes):
        data, age = reports.get(name, ({}, None))
        age_s = f"{age} detik lalu" if age is not None else "belum lapor"
        svcs = data.get("services")
        if not isinstance(svcs, list):    # C-1: tahan data ngawur
            svcs = []
        print(f"  {name:<18} {age_s:<12} {str(data.get('uptime','-')):<18} "
              f"{' '.join(str(s) for s in svcs) or '-'}")
    return 0


def build_message() -> str:
    monitorwibu.prune_reports(REPORTS, FRESH)
    reports = monitorwibu.read_reports(REPORTS, FRESH)
    master = CONF.get("MASTER_NAME", "WIBU MASTER")
    text = monitorwibu.render_message(master, reports)
    return text + f"\n⏱️ <b>Sinkronisasi :</b> <i>{time.strftime('%d %b %Y, %H:%M:%S')} {TZ}</i>"


def cmd_render(send: bool = True) -> int:
    text = build_message()
    if not send:
        print(text)
        return 0
    chat = CONF.get("CHAT_ID")
    if not chat:
        die("CHAT_ID belum diisi di master.conf")
    msg_id = None
    if os.path.exists(MSG_ID_FILE):
        try:
            msg_id = int(open(MSG_ID_FILE).read().strip())
        except ValueError:
            msg_id = None
    if msg_id:
        res = tg("editMessageText", chat_id=chat, message_id=msg_id, text=text, parse_mode="HTML")
        if not res.get("ok") and "not found" in str(res.get("description", "")).lower():
            os.unlink(MSG_ID_FILE)
            msg_id = None
        elif not res.get("ok"):
            print(f"  [!] gagal menyunting pesan: {res.get('description')}", file=sys.stderr)
            return 1
        else:
            return 0
    res = tg("sendMessage", chat_id=chat, text=text, parse_mode="HTML",
             disable_web_page_preview="true")
    if res.get("ok"):
        with open(MSG_ID_FILE, "w") as f:
            f.write(str(res["result"]["message_id"]))
        os.chmod(MSG_ID_FILE, 0o600)
        return 0
    print(f"  [!] gagal mengirim: {res.get('description')}", file=sys.stderr)
    return 1


def cmd_test() -> int:
    """Bukti cepat: kirim laporan bertanda tangan dari master sendiri (node bayangan)."""
    db = monitorwibu.NodeDB(NODES_DB)
    name = list(db.nodes)[0] if db.nodes else None
    if not name:
        die("belum ada node; jalankan: monitorwibu add-node TES")
    key = db.get(name)
    body = json.dumps({"data": {"uptime": "0 Jam, 0 Menit", "city": "Local Test",
                                "services": ["xray:up"], "panel_active": True}}).encode()
    ts = int(time.time())
    sig = monitorwibu.sign(key, body)
    print(f"  uji lokal node '{name}': verifikasi sendiri = {monitorwibu.verify(key, body, sig, ts)[0]}")
    print("  (kirim sungguhan lewat jaringan diuji oleh install-node.sh)")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__)
        return 1
    cmd, args = argv[1], argv[2:]
    if cmd == "add-node" and args:
        return cmd_add_node(args[0])
    if cmd == "del-node" and args:
        return cmd_del_node(args[0])
    if cmd == "list":
        return cmd_list()
    if cmd == "render":
        return cmd_render(send=True)
    if cmd == "show":
        return cmd_render(send=False)
    if cmd == "test":
        return cmd_test()
    print(__doc__)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
